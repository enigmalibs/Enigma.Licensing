<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Mirrors the single net10.0 target of the app under test. The library's suite is the one that
         multi-targets, because the library is the one that multi-targets. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- v3 test projects are executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <!-- ImplicitUsings stays disabled solution-wide (Directory.Build.props); this single global using is the
       one exception, matching the library's suite, so no test file needs to repeat `using Xunit;`. -->
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <!-- Microsoft.Extensions.DependencyInjection and .Logging arrive through the app's own
       Microsoft.Extensions.Hosting reference; the registration suite needs both to build a real
       ServiceProvider, and neither is pinned here because neither is referenced directly. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Enigma.Licensing.Desktop/Enigma.Licensing.Desktop.csproj" />
  </ItemGroup>
</Project>
