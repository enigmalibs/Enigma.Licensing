<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Mirrors the library's modern targets so the netstandard2.0 polyfill surface reachable
         through net8.0 code paths is actually exercised alongside net10.0. netstandard2.0 is never
         a test TFM — it has no runtime to execute on. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- v3 test projects are executables; Main is generated by xunit.v3.core. -->
    <!-- Because this is an Exe, the SDK's EOL-target-framework check (NETSDK1138) is live here — it
         is skipped for Library projects, so the library itself is unaffected. net8.0 leaves support
         2026-11-10; the first SDK that adds 8.0 to _EolNetCoreTargetFrameworkVersions turns this
         project's net8.0 leg into a build error. Fix then: drop net8.0 here, or set
         <CheckEolTargetFramework>false</CheckEolTargetFramework>. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <!-- ImplicitUsings stays disabled solution-wide (Directory.Build.props); this single global using
       is the one exception, so no test file needs to repeat `using Xunit;`. Every other namespace is
       still declared explicitly per file. -->
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <!-- Microsoft.Extensions.DependencyInjection is the concrete container. The library references only
       the abstractions, so the registration tests bring the implementation themselves — that is the
       only way to build a real ServiceProvider and assert what AddEnigmaLicensing() put in it. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Enigma.Licensing/Enigma.Licensing.csproj" />
  </ItemGroup>
  <!-- Fixture copy-glob: files the suite loads by relative path next to the test assembly. The
       convention is in place from bootstrap so later phases only need to drop fixtures in —
       licence/key envelope JSON (*.json) and expected-output or tampered-input text (*.txt). -->
  <ItemGroup>
    <None Update="**/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="**/*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
