<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Multi-targeted because this is a published NuGet library: it mirrors Enigma.Core's TFMs so
         no consumer of Enigma.Core is excluded from it (same reasoning as Enigma.DataEncryption,
         the other successor library built on Core). netstandard2.0 keeps .NET Framework and older
         consumers reachable; net8.0/net10.0 get the modern runtime surface without polyfills. -->
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <!-- Ships the XML doc file consumers get IntelliSense from; also makes a missing doc comment
         on a public member a build error under TreatWarningsAsErrors. On from bootstrap so the
         public surface can never grow undocumented members. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <!-- NuGet packaging metadata (PackageId, Version, Title, Description, PackageTags,
       PackageReadmeFile/PackageLicenseFile + their packing ItemGroup, RepositoryUrl,
       PackageProjectUrl, PackageReleaseNotes) is deliberately absent: it is added at release
       time by FEATURE-57BC (PHASE01), not at bootstrap. -->
  <!-- LangVersion / Nullable / ImplicitUsings / TreatWarningsAsErrors are deliberately absent:
       they come from Directory.Build.props and must never be repeated per-project. No Version
       attributes either — versions live in Directory.Packages.props (CPM). -->
  <!-- Enigma.Core 1.1.0 — the cryptographic engine behind every service here — is referenced by
       FEATURE-03A9, which is also when its pin lands in Directory.Packages.props. -->
  <!-- System.Buffers (Span/Memory/ArrayPool support) is framework-provided on net8.0+; it is only
       needed as an explicit package on netstandard2.0. Referencing it on net8.0/net10.0 would raise
       NU1510 and fail the zero-warnings build. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Buffers" />
  </ItemGroup>
  <!-- PolySharp: polyfills modern C# on netstandard2.0. Compile-only (PrivateAssets=all). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>
</Project>
