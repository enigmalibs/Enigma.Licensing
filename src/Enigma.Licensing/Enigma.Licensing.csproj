<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Multi-targeted because this is a published NuGet library (same reasoning as
         Enigma.DataEncryption, the other successor library built on Core). netstandard2.0 keeps .NET
         Framework and every older runtime reachable — net8.0 included, which FEATURE-A0EB dropped as a
         target because it leaves support on 2026-11-10; net10.0, the current LTS, gets the modern
         runtime surface without polyfills. -->
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <!-- Ships the XML doc file consumers get IntelliSense from; also makes a missing doc comment
         on a public member a build error under TreatWarningsAsErrors. On from bootstrap so the
         public surface can never grow undocumented members. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Trim and AOT analyzers, on the modern TFMs only (netstandard2.0 is never published AOT). They
         are what keeps the library honest now that serialization is source-generated rather than
         reflection-based: any code path that needs runtime reflection becomes a build error here,
         under TreatWarningsAsErrors, instead of an InvalidOperationException in a consumer's published
         app. IsAotCompatible implies IsTrimmable and turns on the trim/single-file/AOT analyzers. -->
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>
  </PropertyGroup>
  <!-- NuGet packaging metadata (FEATURE-57BC-PHASE01). Deliberately absent until release time, per the
       house release workflow. The version lives here rather than in Directory.Build.props because the
       library and the desktop app version independently; FEATURE-82E5 took it to 2.0.0, a major bump
       because five public members were removed from the published 1.0.0, and FEATURE-B6BB to 2.1.0 (net8.0
       target dropped, dependency floors raised, no API change). Keep <PackageReleaseNotes>
       and RELEASENOTES.md in step — the notes below mirror that file's top section. -->
  <PropertyGroup>
    <PackageId>Enigma.Licensing</PackageId>
    <Version>2.1.0</Version>
    <Title>Enigma.Licensing — .NET License Generation &amp; Validation</Title>
    <Description>Generate, sign and validate software licenses in .NET. Licenses are signed JSON envelopes (enigma-license/1) whose signature covers the stored payload bytes exactly — there is no canonicalization step to get wrong — and they can be signed with classical RSA (SHA-256/384/512) or post-quantum ML-DSA (FIPS 204, parameter sets 44/65/87). Key pairs are generated, stored and optionally password-encrypted (Argon2id + AES-256-GCM) in a single enigma-key/1 format. A license carries a product identifier, an owner, an optional validity window and an optional device binding; validation is a verdict rather than an exception, reports the first failing check, and supports anchored wildcard product identifiers. All cryptography comes from Enigma.Core.</Description>
    <PackageTags>license licensing signature rsa ml-dsa fips-204 post-quantum dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <RepositoryUrl>https://github.com/enigmalibs/Enigma.Licensing</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/enigmalibs/Enigma.Licensing</PackageProjectUrl>
    <!-- Written alongside RELEASENOTES.md itself, so the two cannot disagree: this is a prose summary
         of that file's top section, and for a breaking release it ends by pointing at the migration
         guide as well. Rewritten whole on every release, never appended to. There are
         deliberately no symbol properties (IncludeSymbols / SymbolPackageFormat / PublishRepositoryUrl /
         EmbedUntrackedSources) and no GeneratePackageOnBuild: a release ships one .nupkg, packed
         explicitly by the release step rather than by every local build. -->
    <PackageReleaseNotes>A maintenance release with no API change. The net8.0 target is dropped, because .NET 8 leaves support on 2026-11-10: the package now targets netstandard2.0 and net10.0, and a .NET 8 or .NET 9 application resolves the netstandard2.0 build, which has the same public surface. That build carries no trim/AOT annotations, so an application published with trimming or native AOT on .NET 8 or 9 may see trim warnings it did not before. Microsoft.Extensions.DependencyInjection.Abstractions rises from 9.0.18 to 10.0.14, the only supported line once .NET 8 and 9 leave support, and System.Text.Json moves 10.0.12 to 10.0.14 on netstandard2.0. Both document formats, all six signature schemes, the check order, the verdicts and the error contract are unchanged, and every licence and key file ever written still reads. See RELEASENOTES.md for the full details.</PackageReleaseNotes>
  </PropertyGroup>
  <!-- What actually puts the two files in the package — PackageReadmeFile and PackageLicenseFile only
       name them. Both live at the repository root, two levels above this project. -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- LangVersion / Nullable / ImplicitUsings / TreatWarningsAsErrors are deliberately absent:
       they come from Directory.Build.props and must never be repeated per-project. No Version
       attributes either — versions live in Directory.Packages.props (CPM). -->
  <!-- Enigma.Core 2.0.0 — the cryptographic engine behind every service here: RSA and ML-DSA key
       generation and signing, Argon2id key derivation, AES-256-GCM, SHA-256 and hex encoding. It
       multi-targets both of our TFMs, so the reference is unconditional. Its RSA surface takes a
       parsed RsaKey handle rather than PEM text, which LicensingKey imports once per key and holds.
       It is an implementation detail: no Enigma.Core.* or Org.BouncyCastle.* type may reach this
       library's public surface — guarded by PublicSurfaceIsolationTests, which walks the exported
       surface by reflection and also rejects types from Ulid and DeviceId. -->
  <!-- Ulid: the identifier the generator issues when a LicenseRequest carries none. DeviceId: the
       machine-name + OS-version components behind DeviceIdentifier.Generate(). Both multi-target both
       of our TFMs, so both references are unconditional; both are MIT. Like Enigma.Core they are
       implementation details — no Ulid or DeviceId type reaches this library's public surface, which
       is why DeviceIdentifier.Generate() returns a plain string. -->
  <!-- Microsoft.Extensions.DependencyInjection.Abstractions: the abstractions only, never the concrete
       container — a library registers services, it does not build the provider. It is the one dependency
       deliberately visible on the public surface (AddEnigmaLicensing takes and returns
       IServiceCollection); the isolation guard test knows about that exception. Unconditional: it
       multi-targets both of our TFMs and is not part of any shared framework, so no NU1510. -->
  <ItemGroup>
    <PackageReference Include="Enigma.Core" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Ulid" />
    <PackageReference Include="DeviceId" />
  </ItemGroup>
  <!-- System.Buffers (Span/Memory/ArrayPool support) and System.Text.Json are framework-provided on
       net10.0; they are only needed as explicit packages on netstandard2.0. Referencing either on
       net10.0 would raise NU1510 and fail the zero-warnings build. The library's JSON use is
       confined to what System.Text.Json 8.0 already supports (required members, IReadOnly*
       collections), so the inbox version on the modern TFM is sufficient. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Buffers" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>
  <!-- PolySharp: polyfills modern C# on netstandard2.0. Compile-only (PrivateAssets=all). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>
</Project>
