<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Only what the code actually references is pinned here. Every later dev adds its own pins when
       the reference lands, not before. -->
  <!-- Library. Enigma.Core is the cryptographic engine behind every service here and is referenced on
       all three TFMs — it multi-targets exactly the same set. It brings BouncyCastle.Cryptography
       2.7.0 transitively; neither type may appear on this library's public surface.

       2.0.0 (FEATURE-6C54) takes RSA keys as a reusable Enigma.Core RsaKey handle instead of PEM
       strings, which is why LicensingKey parses its material once and holds it. The major bump changed
       no dependency of Core's — still BouncyCastle 2.7.0, still System.Buffers 4.6.1 on
       netstandard2.0 — and no key or licence file this library writes. -->
  <!-- System.Buffers (Span/Memory), System.Text.Json and PolySharp (compile-only C# polyfills) are
       the netstandard2.0-support set and are referenced ONLY under that TFM in the library csproj:
       net8.0/net10.0 get System.Text.Json from the shared framework, and referencing the package
       there would raise NU1510 and fail the zero-warnings build. The 10.0.x line is the one whose own
       netstandard2.0 dependency set already matches the System.Buffers 4.6.1 pinned here — which is
       also the version Enigma.Core's own netstandard2.0 dependency group asks for; FEATURE-82E5 took
       the 10.0.10 → 10.0.12 servicing patch, which moves nothing else in the graph. -->
  <!-- Ulid 1.4.1 (MIT) mints the identifier the generator stamps on a license when the caller supplies
       none: lexicographically sortable by creation time, unlike a GUID, so a directory listing of
       issued licenses is in issue order. On netstandard2.0 it asks for System.Memory and
       System.Runtime.CompilerServices.Unsafe, both of which the graph already closes over.
       DeviceId 6.11.0 (MIT) backs DeviceIdentifier.Generate(). Only the base package is referenced —
       machine name and OS version live there; the DeviceId.Windows/.Linux/.Mac packages exist for
       hardware-bound components this library deliberately does not use. It multi-targets all three of
       ours, and on netstandard2.0 alone it pulls Microsoft.DotNet.PlatformAbstractions 3.1.6. -->
  <!-- Microsoft.Extensions.DependencyInjection.Abstractions 9.0.18 (MIT) is what AddEnigmaLicensing()
       extends, and the ONLY dependency whose types are allowed on this library's public surface — the
       extension method takes and returns IServiceCollection, which is the whole point of it. The floor
       is deliberately low: 9.x, matching Enigma.DataEncryption, because NuGet resolves a package
       reference to the highest floor any project in the graph asks for, so a high floor here would drag
       an application's whole Microsoft.Extensions.* set forward. It multi-targets all three of ours;
       on netstandard2.0 it pulls Microsoft.Bcl.AsyncInterfaces 9.0.18 and
       System.Threading.Tasks.Extensions 4.5.4 (net8.0+ have both inbox). -->
  <ItemGroup>
    <PackageVersion Include="Enigma.Core" Version="2.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.18" />
    <PackageVersion Include="System.Buffers" Version="4.6.1" />
    <PackageVersion Include="System.Text.Json" Version="10.0.12" />
    <PackageVersion Include="PolySharp" Version="1.16.0" />
    <PackageVersion Include="Ulid" Version="1.4.1" />
    <PackageVersion Include="DeviceId" Version="6.11.0" />
  </ItemGroup>
  <!-- Desktop app (FEATURE-179C). Hosting and logging first: Microsoft.Extensions.Hosting is what builds
       the IHost that App.axaml.cs owns, and it is what brings Microsoft.Extensions.DependencyInjection —
       the concrete container — into the app. The two logging sinks are the house pair: Console for a
       terminal launch, Debug for an attached debugger. The app writes no log files (validated decision),
       so no file sink is pinned. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
  </ItemGroup>
  <!-- Desktop (Avalonia) — a version-coupled ecosystem: Avalonia, the Fluent theme, the Inter fonts and
       the diagnostics support are bumped TOGETHER, never one package at a time, because mixing versions
       within the set breaks the build. Enigma.Avalonia.Desktop 1.0.0 belongs to the same unit: it pins
       Avalonia 12.1.1, Avalonia.Themes.Fluent 12.1.1 and CommunityToolkit.Mvvm 8.4.2 — exactly the
       versions below — and Enigma.Icons.Avalonia needs Avalonia >= 12.1.0 for the same reason.

       Avalonia, Avalonia.Themes.Fluent and CommunityToolkit.Mvvm arrive transitively through the control
       library, and Enigma.Icons / Enigma.Icons.Phosphor through Enigma.Icons.Avalonia; all five are pinned
       explicitly anyway (house convention) so the version is visible here rather than inherited.

       AvaloniaUI.DiagnosticsSupport replaces Avalonia.Diagnostics, which was removed in Avalonia 12; the
       app csproj strips it out of every non-Debug build.

       Enigma.Avalonia.Desktop also brings Enigma.Core (>= 1.0.0) transitively, behind its Base64 and
       hexadecimal editors. The graph closes on the 2.0.0 pinned above for the library, so there is one
       Enigma.Core — and one BouncyCastle.Cryptography — in the app. That the control library is built
       against 1.x is not a problem across Core's major bump: its assembly references Enigma.Core.Encoding
       and nothing from the RSA or certificate surface, which is the only surface 2.0.0 changed. -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Enigma.Avalonia.Desktop" Version="1.0.0" />
    <PackageVersion Include="Enigma.Icons" Version="1.0.0" />
    <PackageVersion Include="Enigma.Icons.Phosphor" Version="1.0.0" />
    <PackageVersion Include="Enigma.Icons.Avalonia" Version="1.0.0" />
  </ItemGroup>
  <!-- Tests (MTP-native: xunit.v3 only; coverlet.collector for coverage). No Microsoft.NET.Test.Sdk.
       Microsoft.Extensions.DependencyInjection is the concrete container — needed only to build a real
       ServiceProvider and assert what AddEnigmaLicensing() registered. Same version as the abstractions
       the library pins, so the test graph resolves to exactly the floor a consumer would get. -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.18" />
  </ItemGroup>
</Project>
